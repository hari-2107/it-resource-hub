rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function: Check if user is the owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Helper function: Check if user has admin or co-admin role
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'co-admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'co-admin']
      );
    }

    // 1. User Profiles & Private Data (marks, BrainZone progress, custom timetables, favorites)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin() && request.auth.uid != userId;
      
      // Sub-collections under user (marks, progress, history)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Materials Library
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 3. Announcements & Notices
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 4. Company Recruitment Drives
    match /placementCompanies/{companyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 5. Interview Experiences
    match /interviewExperiences/{experienceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || resource.data.authorId == request.auth.uid;
    }

    // 6. Events & Hackathons
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 7. BrainZone Content & Challenges
    match /brainZoneContent/{contentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 8. Department Broadcasts & Popup Alerts
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 9. Site Configuration & Maintenance Settings
    match /siteConfig/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 10. Student Suggestions & Reported Issues
    match /suggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
